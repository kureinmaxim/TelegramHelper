# ============================================================
# TelegramHelper environment template
# ============================================================
# Copy this file to .env and fill in the values.
# NEVER commit a real .env file.
#
# The installer (scripts/install_telegramhelper_docker.sh or vps_setup)
# can prompt for BOT_TOKEN / ADMIN_USER_IDS and generate API_SECRET_KEY
# + HMAC_SECRET when they are still placeholders.
# ============================================================

# === REQUIRED ON FIRST DEPLOY ===
# Token from @BotFather (format: 123456789:AA...)
BOT_TOKEN=your_telegram_bot_token_here

# Telegram admin IDs, comma-separated, no spaces
# Discover with @userinfobot or /id after the bot starts
ADMIN_USER_IDS=123456789

# Primary API key (32+ characters). Placeholder is replaced by the installer:
# python3 -c "import secrets; print(secrets.token_hex(32))"
API_SECRET_KEY=your_very_long_random_secret_key_here_64_chars_minimum

# HMAC signing secret (32+ characters). Installer can generate:
# openssl rand -hex 32
HMAC_SECRET=another_random_secret_for_hmac_signing_also_64_chars

# Public API URL shown by /api. Replace YOUR_SERVER_IP with this VPS.
API_URL=http://YOUR_SERVER_IP:8000/ai_query

# === AI PROVIDERS (optional) ===
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

OPENAI_API_KEY=sk-proj-your-key-here
OPENAI_MODEL=gpt-4o

# Default provider: anthropic or openai
DEFAULT_AI_PROVIDER=anthropic

# === PUBLIC VPS ADDRESS AND SSH (optional, used by the bot) ===
# Compose passes .env into the telegram-helper container.
# If vless_config.json already has a server field, that value wins.
#
# Host priority: DOCKHAND_SSH_HOST, TELEGRAMHELPER_SSH_HOST,
# TELEGRAMHELPER_PUBLIC_HOST, PUBLIC_HOST, VPS_HOST, then VLESS server.
#
# DOCKHAND_SSH_HOST=YOUR_SERVER_IP
# TELEGRAMHELPER_PUBLIC_HOST=YOUR_SERVER_IP
# DOCKHAND_SSH_PORT=22
# DOCKHAND_SSH_USER=root

# === OFFSITE BACKUPS VIA RCLONE (optional) ===
# RCLONE_REMOTE=encrypted:
# RCLONE_BACKUP_PREFIX=telegramhelper
# RCLONE_CONFIG=/rclone/rclone.conf
# RCLONE_BACKUP_TIMEOUT=300
# RCLONE_BACKUP_LOG_MAX_MB=20
# DOCKHAND_API_KEY=your_api_key_for_admin_command
# DOCKHAND_APP_ID=example-app
# DOCKHAND_HIDE_HEALTH_DEFAULT=true
# DOCKHAND_LOG_DEFAULT_TAB=all

# === DOCKER COMPOSE NETWORK SUBNETS (optional) ===
# COMPOSE_DEFAULT_SUBNET=172.20.0.0/16
# COMPOSE_SOCKET_PROXY_SUBNET=172.21.0.0/16

# AES-256 key. If empty, API_SECRET_KEY is used.
# python3 -c "import secrets; print(secrets.token_hex(32))"
ENCRYPTION_KEY=optional_separate_encryption_key_otherwise_api_secret_is_used

# === SECURITY SETTINGS ===
ENABLE_SIGNATURE_CHECK=true
ENABLE_TIMESTAMP_CHECK=true
ENABLE_NONCE_CHECK=true
ENABLE_RATE_LIMITING=true
ENABLE_APP_WHITELIST=true
TIMESTAMP_TOLERANCE=300

# Allowed APP_ID values, comma-separated
ALLOWED_APP_IDS=example-app,test-client

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_DAY=1000

LOG_LEVEL=INFO
# LOG_FILE=/var/log/telegramhelper/api.log

# ALLOWED_IPS=192.168.1.100,10.0.0.50

HYSTERIA2_CONFIG_PATH=hysteria2_config.json
HYSTERIA2_ENABLED=false

MTPROTO_CONFIG_PATH=mtproto_config.json
MTPROTO_ENABLED=false

# REDIS_URL=redis://localhost:6379/0

# ============================================================
# SMTP for /email_profile
# ============================================================
# Fill SMTP_HOST / SMTP_USER / SMTP_PASS to enable. Leave empty to disable.
#
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=you@example.com
# SMTP_PASS=your_app_password
# SMTP_FROM=you@example.com
# SMTP_USE_TLS=starttls
# SMTP_BLOCKED_TLDS=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_USE_TLS=starttls
SMTP_BLOCKED_TLDS=

# Optional Gmail API (paths on the server, never commit the JSON files)
GMAIL_OAUTH_CREDENTIALS=
GMAIL_TOKEN_PATH=
# GMAIL_FROM=you@example.com
