[reticulum]
  enable_transport = No
  share_instance = No
  panic_on_interface_error = No

[logging]
  loglevel = 3

[interfaces]
  # Simple interface (stage 1). Listens on localhost only — access via SSH tunnel.
  # Later replace with I2PInterface (stage 3); bridge code stays the same.
  [[TCP Server Interface]]
    type = TCPServerInterface
    interface_enabled = yes
    listen_ip = 127.0.0.1
    listen_port = 50061
