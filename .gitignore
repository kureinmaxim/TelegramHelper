# Exclude local configs/secrets (NOT example.env — it is a template!)
.env
.env.*
*.env.local
CREDENTIALS.txt
rclone/
rclone.conf

# Local non-public variants of any tracked document/config.
# Convention: SOMETHING.md (template, in git) <-> SOMETHING.local.md (real values, ignored).
*.local.md
*.local.yaml
*.local.yml
*.local.json
*.local.txt

# Keys / certificates accidentally placed alongside the project
*.pem
*.key
*.crt
*.cer
*.p12
*.pfx
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
known_hosts

# Python
__pycache__/
*.pyc
*.pyo
*.pyd

# Virtual environments
venv/
.venv/

# HA stack (stubs) — runtime artifacts on the VPS (do not commit identity/keys)
ha_stack/.rnsdata/
*identity

# Logs and runtime artifacts
*.log
bot.log

# SSH CLI dashboard history (bind-mounted; see compose.yaml). Lives on the VPS.
.cli_history

# OS/editor
.DS_Store
.vscode/
.idea/
*.swp
*.swo
*.code-workspace
.cursor/

# Backups / scratch
*.bak
*.backup
*.orig
*.tmp
*~

# gitleaks local reports
gitleaks-report.json
gitleaks-report.sarif
.gitleaks/

# User data
users.json
conversation_history.json
app_keys.json
