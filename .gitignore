mieru_config.json
xui_config.json
vless_configs/

# Headplane runtime: real config with cookie_secret + Headscale API key,
# plus persistent data. Commit the template headplane/config.example.yaml.
headplane/config.yaml
headplane/data/

# Gmail API OAuth (local secrets; do not commit)
gmail_token.json
gmail_oauth_client.json
client_secret*.apps.googleusercontent.com.json

# === Markdown docs are tracked by default ===
# Any new *.md in the repo is committed automatically — you do not need to
# whitelist each document. Keep secrets/inventory out of git by NAMING, not
# by allowlists: for real values (keys, UUIDs, IPs, domains, secret paths)
# use one of the ignored suffixes below.
#
# NEVER put real secrets in a normal tracked .md — it will go to GitHub.
# Real values belong in *.private.md / *.local.md / *.secret.md /
# INFRA_LOCAL.md (ignored below), or in a private inventory repo under hosts/.
*.local.md
*.private.md
*.secret.md
INFRA_LOCAL.md
INFRA_*.local.md
# Exception: SERVER_STATE.local.md is a SAFE filled-in example
# (RFC 5737 IPs, example.com, placeholder secrets) and is tracked on purpose.
# Do not put real data in it.
!SERVER_STATE.local.md

# === hosts/ VPS inventory ===
# The template and shared README are tracked, but the contents of named
# host folders (hosts/<hostname>/) are not. Those files reveal ports,
# domains, ownership, and secret locations; even without values that is
# useful reconnaissance. Back up real host folders with rclone or a
# separate private repository.
hosts/*/
!hosts/_template/
!hosts/_template/**

# Template / shared .md files under hosts/ (in case a folder is ignored).
!hosts/README.md
!hosts/SNAPSHOT_COLLECT.md
!hosts/_template/*.md

# Brainstorming / spec documents are tracked.
!docs/superpowers/specs/*.md

# Nested inventory-repo metadata (telegramhelper-hosts).
# .git/ is ignored by git everywhere; INVENTORY.md from the inventory
# repo must not land in the main repository.
# (Inventory-repo exclude rules live in hosts/.git/info/exclude,
# outside this worktree, so the main repo does not see them.)
hosts/INVENTORY.md

# Superpowers design specs (docs/superpowers/specs/) are tracked:
# project decisions without secrets.
!docs/superpowers/specs/*.md
!docs/superpowers/plans/*.md
